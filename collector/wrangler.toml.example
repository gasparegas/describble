# Copy to wrangler.toml (git-ignored) and fill in your own ids.
name = "scribble-word-reports"
main = "worker.js"
compatibility_date = "2026-10-01"

[[kv_namespaces]]
binding = "WORDS"
id = "<your KV namespace id>"

# The export token is a secret, never written here:
#   npx wrangler secret put EXPORT_TOKEN
